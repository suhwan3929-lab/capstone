[Unit]
# 대시보드. 죽어도 안전 기능에 영향이 없어야 한다.
Description=Walker dashboard (non-critical)
After=walker-safety.service
# ★ Requires= / BindsTo= 를 쓰지 말 것.
#   UI 실패가 fall 서비스를 끌어내리면 분리한 의미가 없다.

[Service]
Type=simple
User=walker
WorkingDirectory=/opt/walker
Environment=DISPLAY=:0
ExecStart=/opt/walker/venv/bin/python -u ui.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target

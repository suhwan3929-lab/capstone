# 개인/보드별 설정 덮어쓰기
#
# 이 파일을 `config_local.py` 로 복사해서 쓰세요. (git에 올라가지 않습니다)
# 사람마다 COM 번호가 다르므로 config.py 를 직접 고치면 매번 충돌합니다.

# ── 개발 PC (Windows) ─────────────────────────────
IMU_PORT = "COM6"
GPS_PORT = "COM5"
LIDAR_PORT_LEFT = "COM3"
LIDAR_PORT_RIGHT = "COM10"
LIDAR_SOURCE = "serial"

# ── Raspberry Pi 5 (실기) ────────────────────────
# udev 규칙으로 고정 심볼릭 링크를 먼저 만들 것.
# /dev/ttyUSB0 번호는 부팅 순서에 따라 바뀐다.
#
# IMU_PORT = "/dev/walker_imu"
# GPS_PORT = "/dev/walker_gps"
# LIDAR_SOURCE = "udp"          # LiDAR는 Jetson의 ROS 2 노드에서 받는다

# ── IMU 장착각 보정 ──────────────────────────────
# `python fall_monitor.py --calibrate` 로 측정한 값을 넣으세요.
# 보행기에 기울여 달았다면 이 값이 0이 아닙니다.
# MOUNT_ROLL_OFFSET_DEG  = 0.0
# MOUNT_PITCH_OFFSET_DEG = 0.0

# ── 실험 중 임계값 조정 ──────────────────────────
# tools/analyze_logs.py 결과로 확정하기 전까지 임시 조정용
# IMPACT_THRESHOLD_G = 2.8
# FALL_TILT_DEG = 60.0
